        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/.godot/**": true,
            "**/.venv/**": true,
            "**/__pycache__/**": true,
            "**/llm-models/**": true,
            "**/single-room/tools/tts/**": true,
