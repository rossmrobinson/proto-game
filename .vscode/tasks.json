{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Scanners: Run All",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/scanners/run-all.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Scanners: Godot Check",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/scanners/godot-check.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Print Paths",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/print-cache-paths.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear Logs",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-user-cache.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear User Data",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-user-cache.ps1",
        "-All"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear Project Cache",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-project-cache.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear All",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-all-caches.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear All (Global)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-all-caches.ps1",
        "-IncludeGlobal"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Status",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/cache-status.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Prune Logs (7d)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/prune-logs.ps1",
        "-Days",
        "7"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear Global Only",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-global-cache.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear GPU Shader",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-gpu-shader-cache.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Cache: Clear Nuclear",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/single-room/tools/cache/clear-nuclear.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "LLM Proxy: Start",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/single-room/tools/llm-proxy/proxy-server.py"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "LLM Proxy: Health",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-Command",
        "Invoke-RestMethod http://127.0.0.1:8787/health"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rig Upgrade: Model Builder (Player1 male)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/single-room/tools/blender-upgrade-pipeline.py",
        "--blend",
        "J:/proto-game-blender/model-builder.blend",
        "--blender-path",
        "C:/Program Files/Blender Foundation/Blender 4.5/blender.exe",
        "--sex",
        "auto",
        "--male-armatures",
        "Player1",
        "--save",
        "--strict",
        "--copy-rig-dump-to",
        "${workspaceFolder}/single-room/logs/model-builder-rig-dump.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rig Upgrade: Model Builder (Player1 only)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/single-room/tools/blender-upgrade-pipeline.py",
        "--blend",
        "J:/proto-game-blender/model-builder.blend",
        "--blender-path",
        "C:/Program Files/Blender Foundation/Blender 4.5/blender.exe",
        "--armature",
        "Player1",
        "--sex",
        "male",
        "--save",
        "--strict",
        "--copy-rig-dump-to",
        "${workspaceFolder}/single-room/logs/model-builder-player1-rig-dump.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "Rig Upgrade: Model Builder (Ada only)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "${workspaceFolder}/single-room/tools/blender-upgrade-pipeline.py",
        "--blend",
        "J:/proto-game-blender/model-builder.blend",
        "--blender-path",
        "C:/Program Files/Blender Foundation/Blender 4.5/blender.exe",
        "--armature",
        "Ada",
        "--sex",
        "female",
        "--save",
        "--strict",
        "--copy-rig-dump-to",
        "${workspaceFolder}/single-room/logs/model-builder-ada-rig-dump.json"
      ],
      "problemMatcher": []
    }
  ]
}
